# Copy to .env locally. These placeholders are not deployment credentials.
APP_ENV=development
APP_ORIGIN=http://localhost:5171
ALLOWED_ORIGINS=http://localhost:5171
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_CURRENCY=INR
COMPOSE_PROJECT_NAME=cadentra-platform
WEB_PORT=5171
API_PORT=8001
POSTGRES_PORT=5433
POSTGRES_DB=cadentra_platform
POSTGRES_USER=cadentra
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DATABASE_URL=postgresql+psycopg://cadentra:REPLACE_WITH_LOCAL_PASSWORD@localhost:5433/cadentra_platform
TEST_DATABASE_URL=postgresql+psycopg://cadentra:REPLACE_WITH_LOCAL_PASSWORD@localhost:5433/cadentra_platform_test
SESSION_COOKIE_SECURE=false
# Required in production: exact private web-proxy IP literals, never * or a CIDR.
# compose.dokploy.yaml supplies its dedicated web address. Native dev leaves empty.
TRUSTED_WEB_PROXY_IPS=
SESSION_TTL_SECONDS=86400
RESET_TOKEN_TTL_SECONDS=1800
# Native API uses localhost; Compose overrides with COMPOSE_SMTP_HOST.
SMTP_HOST=localhost
COMPOSE_SMTP_HOST=mailpit
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.invalid
SMTP_STARTTLS=false
WORKER_POLL_SECONDS=30
# Set locally for explicit bootstrap/seed commands; never commit real credentials.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=REPLACE_WITH_COMPLIANT_PASSWORD

# Role testing is explicit and disabled by default. Store only an Argon2 hash here.
DEV_TOOLS_ENABLED=false
DEMO_INSTANCE=false
DEV_PASSWORD_HASH=
